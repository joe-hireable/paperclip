+  it.each(["cancel", "pause", "shutdown"] as const)("awaits owned-group cleanup during %s without numeric fallback", async (action) => {
+    const { agentId, runId } = await seedRunFixture({ agentStatus: "running", includeIssue: false });
+    const heartbeat = heartbeatService(db);
+    let finish!: () => void;
+    const draining = new Promise<void>((resolve) => { finish = resolve; });
+    const signalOwnedGroup = vi.fn(async () => { await draining; return { status: "gone" as const, forceKilled: false }; });
+    runningProcesses.set(runId, { child: { pid: 12345 } as ChildProcess, graceSec: 1, processGroupId: 12345, signalOwnedGroup });
+    mockTerminateLocalService.mockResolvedValue(undefined);
+    let settled = false;
+    const cancellation = (action === "cancel" ? heartbeat.cancelRun(runId)
+      : action === "pause" ? heartbeat.cancelActiveForAgent(agentId)
+      : heartbeat.drainRunningRunsForShutdown("SIGTERM", new Date(), [runId])).finally(() => { settled = true; });
+    try {
+      await vi.waitFor(() => expect(signalOwnedGroup).toHaveBeenCalledWith("SIGTERM"));
+      expect(settled).toBe(false);
+      expect(runningProcesses.has(runId)).toBe(true);
+      expect(mockTerminateLocalService).not.toHaveBeenCalled();
+      finish();
+      await cancellation;
+      expect(signalOwnedGroup).toHaveBeenCalledTimes(1);
+      expect(runningProcesses.has(runId)).toBe(false);
+    } finally { finish(); await cancellation; runningProcesses.delete(runId); }
+  });
